generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// NextAuth Required Models
model Account {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  userId             String  @db.ObjectId
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.String
  access_token       String? @db.String
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.String
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(STUDENT)
  
  // Custom Gamification Stats
  level         Int       @default(1)
  xp            Int       @default(0)
  stars         Int       @default(0)
  streak        Int       @default(1)

  accounts      Account[]
  sessions      Session[]
  submissions   Submission[]
  chatSessions  ChatSession[]
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

// PriEdu Core Models
model Submission {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId        String   @db.ObjectId
  imageUrl         String
  extractedText    String
  feedback         String
  correctnessScore Float
  neatnessScore    Float
  createdAt        DateTime @default(now())
  
  student          User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Exam {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  teacherId   String   @db.ObjectId
  title       String
  topic       String
  gradeLevel  String
  questions   Json
  createdAt   DateTime @default(now())
}

model ChatSession {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String   @db.ObjectId
  startedAt   DateTime @default(now())
  messages    Message[]
  
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Message {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  chatSessionId String   @db.ObjectId
  role          SenderRole
  content       String
  createdAt     DateTime @default(now())

  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
}

enum SenderRole {
  user
  assistant
  system
  data
}

// Analytics
model KnowledgeNode {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId   String   @db.ObjectId
  nodeKey     String   // e.g. "math.fractions.addition"
  mastery     Float    // 0.0 to 1.0
  lastTested  DateTime @default(now())

  @@unique([studentId, nodeKey])
}
